# --- Backend ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/eventhub
SECRET_KEY=replace-with-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional: seeds a Super Admin on first start
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123
ENABLE_SCHEDULER=1
SCHEDULER_INTERVAL_SECONDS=300
REMINDER_WINDOW_HOURS=24

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventhub

# --- Frontend (build time) ---
VITE_API_URL=http://localhost:8000
